{
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/*.p12)",
      "Read(//**/*.pfx)",
      "Read(//**/id_rsa*)",
      "Read(//**/id_ed25519*)",
      "Read(//**/id_ecdsa*)",
      "Read(//**/secrets/**)",
      "Read(//**/.npmrc)",
      "Read(//**/.pypirc)",
      "Read(//**/.netrc)",
      "Read(//**/*.credentials.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(//**/.env)",
      "Edit(//**/.env.*)",
      "Edit(//**/*.pem)",
      "Edit(//**/*.key)",
      "Edit(//**/*.p12)",
      "Edit(//**/*.pfx)",
      "Edit(//**/id_rsa*)",
      "Edit(//**/id_ed25519*)",
      "Edit(//**/id_ecdsa*)",
      "Edit(//**/secrets/**)",
      "Edit(//**/.npmrc)",
      "Edit(//**/.pypirc)",
      "Edit(//**/.netrc)",
      "Edit(//**/*.credentials.json)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)"
    ]
  },
  "model": "opus",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME_JSON}}\\hooks\\agent-done.js\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"{{CLAUDE_HOME_JSON}}\\statusline-command.ps1\""
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "language": "Korea",
  "effortLevel": "medium",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  }
}
